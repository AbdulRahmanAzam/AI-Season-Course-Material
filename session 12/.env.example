# Copy this file to ".env" and (optionally) put your real Groq key below.
#
# Get a FREE Groq key here:  https://console.groq.com/keys
#
# If you leave the key as-is (or blank), Files 07-09 run in MOCK mode:
# the agents still work, they just return canned answers instead of calling
# a real LLM. That means the whole lesson runs with NO api key at all. 👍

GROQ_API_KEY=your_groq_key_here

# Set to "groq" to use the real LLM, or "mock" to force offline demo mode.
LLM_PROVIDER=groq
